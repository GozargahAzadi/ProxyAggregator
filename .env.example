# ProxyAggregator Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database (SQLite default)
PA_DATABASE_URL=sqlite:///proxyaggregator.db

# GitHub (required for publishing)
PA_GITHUB_TOKEN=
PA_GITHUB_REPO=

# GeoIP (country-level MMDB, e.g. ip-location-db user-country.mmdb)
PA_GEOIP_DB_PATH=user-country.mmdb

# Health Check
PA_HEALTH_CHECK_TIMEOUT=10
PA_HEALTH_CHECK_CONCURRENCY=50

# Source Fetching
PA_FETCH_TIMEOUT=30
PA_MAX_RESPONSE_BYTES=10485760

# Logging
PA_LOG_LEVEL=INFO
